# Supabase project credentials.
#
# Copy to `.env.local` and fill in from
# Supabase Dashboard > Project Settings > API.
#
# Only the publishable (anon) key belongs here. Never put the `service_role`
# secret in a NEXT_PUBLIC_ variable: anything prefixed that way is sent to the
# browser, which would hand full database access to any visitor.

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key-here

# Cloudflare Turnstile (optional; when configured, login/register require captcha)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key
TURNSTILE_SECRET_KEY=your-turnstile-secret-key

# Idle auto-logout window, in milliseconds. Defaults to 900000 (15 minutes).
# Override it in a deployed environment to verify the guard without sitting for
# a quarter of an hour — 20000 signs out after 20 seconds of no activity.
# Anything under 1000 is ignored, so a typo cannot fire it between keystrokes.
# NEXT_PUBLIC_IDLE_TIMEOUT_MS=900000

# Better Auth configuration.
# Copy to `.env.local` and fill in.
# DATABASE_URL is the Supabase Postgres connection string (from Settings > Database).
# If your machine/network has no IPv6, use the IPv4 connection pooler instead of
# the direct host (`db.<ref>.supabase.co` is IPv6-only and fails with ENOTFOUND).
# Use port 6543 (TRANSACTION mode) for anything the app itself runs:
#   postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# Port 5432 is the SESSION pooler. It pins one Postgres backend per connection
# for the connection's whole life and caps at 15 for the entire project, so an
# app on 5432 exhausts it and fails with "EMAXCONNSESSION". Reserve 5432 for
# one-off scripts (migrations, psql) that genuinely need session state.
# BETTER_AUTH_SECRET must be at least 32 chars: openssl rand -base64 32
# BETTER_AUTH_URL is your app URL.

DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres
BETTER_AUTH_SECRET=your-secret-at-least-32-chars
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000

# Supabase service role, server-side only (no NEXT_PUBLIC_ prefix).
# Used to delete files from the `avatars` bucket — Supabase refuses a SQL
# DELETE on storage.objects, so an avatar can only go through the Storage API.
# Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_your-service-role-key

# Bearer token for GET /api/cron/purge-deletions. Vercel sends it automatically
# for the job declared in vercel.json. Without it the route refuses every call,
# which means an account flagged for deletion is never actually destroyed —
# it just stops being reachable.
CRON_SECRET=your-cron-secret

# Resend API configuration
RESEND_API_KEY=re_your_api_key_here
EMAIL_FROM=Ruang <onboarding@resend.dev>

# Google OAuth (optional).
#
# Google sign-in only appears when BOTH values are set; setting one without the
# other throws at boot rather than failing later on click.
#
# Create the credentials at https://console.cloud.google.com/apis/credentials
#   > Get credentials > OAuth client ID > Web application
# Authorised redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google
# Authorised JavaScript origin: <BETTER_AUTH_URL>
AUTH_GOOGLE_ID=your-client-id.apps.googleusercontent.com
AUTH_GOOGLE_SECRET=your-client-secret
