# EXPO_PUBLIC_API_URL — override dasar API ruang.
# Default (kalau tidak diset): https://ruang-cashflow.vercel.app (lihat src/config.js)
EXPO_PUBLIC_API_URL=https://ruang-cashflow.vercel.app

# EXPO_PUBLIC_SUPABASE_URL — origin Storage API untuk foto profil.
# Default: project Supabase produksi (lihat src/config.js). Ini URL publik,
# bukan kunci; jangan pernah memasukkan service_role di sini.
# EXPO_PUBLIC_SUPABASE_URL=https://bqgxiiuaefbnxslzkoek.supabase.co
